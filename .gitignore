# =============================================================================
# TAME-Swarm .gitignore
# =============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.so

# ── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Model Artifacts (large binaries) ────────────────────────────────────────
tame/model_cache/
tame/tame_checkpoints/
tame/tame_inference/
*.safetensors
*.bin
*.pt
*.onnx
*.gguf

# ── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*

# ── Docker ──────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Research / Private ──────────────────────────────────────────────────────
Implementing_Multi-Scale_Competency_in_Large_Language_Models-A_Bio-Inspired_Architecture_for_Agential_Homeostasis.md

# ── Misc ────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# mutmut working tree
mutants/

# hypothesis example database (tests/test_auction_properties.py)
.hypothesis/

# ── MLflow local tracking store (#7) ───────────────────────────────────────
mlruns/

# ── Claude Code (#50) ───────────────────────────────────────────────────────
# The gate itself is tracked; only what a session writes is not. `.claude/state/`
# is per-session marker files keyed to a working-tree fingerprint, and
# settings.local.json is one machine's overrides — committing either would hand
# the next checkout a pass it never earned.
.claude/state/
.claude/settings.local.json
# A /council roster is written per run and read by nobody else. Left untracked and
# unignored it makes `git status --porcelain` dirty, which is what
# `parity.code_identity()` reads: every fingerprint recorded from this checkout
# would say the SHA identifies no code (#46).
.claude/perspectives.md
