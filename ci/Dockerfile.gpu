# syntax=docker/dockerfile:1

# ── Builder: install all deps with CUDA torch ──────────────────────────────
# Use python:3.12-slim (not nvidia/cuda) — builder only installs wheels,
# no CUDA libs needed. Avoids deadsnakes PPA overhead on Ubuntu 22.04.
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.10.10 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-system

COPY pyproject.toml uv.lock README.md ./
RUN mkdir -p tame && touch tame/__init__.py

RUN uv sync --frozen --extra dev --no-install-project

# ── Runtime: CUDA base with pre-built venv ─────────────────────────────────
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       python3.12 python3.12-venv git libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python

COPY --from=ghcr.io/astral-sh/uv:0.10.10 /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy \
    UV_PYTHON_PREFERENCE=only-system \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY --from=builder /app/.venv .venv
COPY pyproject.toml uv.lock README.md ./
